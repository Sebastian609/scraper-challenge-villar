# Configuración del scraper TRF5 (PJE)
# Copia este archivo a `.env` y ajusta los valores según necesites.
# Todos los parámetros son opcionales; si se omiten se usan los defaults.

# Intervalo mínimo entre peticiones HTTP (ms)
DELAY_MS=1000
# Demora aleatoria extra añadida a DELAY_MS (ms)
JITTER_MS=200
# Descargas de PDF en paralelo
CONCURRENCY=3
# Timeout de cada petición axios (ms)
TIMEOUT_MS=30000
# Reintentos ante respuestas 429/503
MAX_RETRIES=3
# Base del backoff exponencial (ms): BACKOFF_MS * 2^(intento-1)
BACKOFF_MS=1000

# Poner en 1 para reintentar SOLO los fallos registrados en output/failed.json
# RETRY_FAILED=1
